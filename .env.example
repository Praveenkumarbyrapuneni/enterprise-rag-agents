# ── AWS Bedrock (all AI calls — data never leaves the VPC) ───────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model IDs — override if your account uses cross-region inference profiles
BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ── Embedder ──────────────────────────────────────────────────────────────────
# "haiku" = contextual enrichment via Claude Haiku before embedding (recommended)
# "skip"  = embed raw chunk text directly (no Haiku calls)
EMBEDDER_CONTEXT_MODE=haiku

# ── Vector Store (Docker locally, Qdrant Cloud on AWS) ────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# ── Task Queue (Redis Docker locally, SQS on AWS — only URL changes) ──────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Metadata + Hash Store (PostgreSQL Docker locally, RDS on AWS) ─────────────
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb

# ── Chunker ───────────────────────────────────────────────────────────────────
# "haiku" = Claude Haiku classifies chunk type (financial table, narrative, etc.)
# "keyword" = simple keyword classifier (no Bedrock call, faster, less accurate)
CHUNK_CLASSIFIER=haiku

# ── Tracing ────────────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=enterprise-rag-agents

# ── API ────────────────────────────────────────────────────────────────────────
API_KEY=

# ── AWS Phase B migration — only these change when moving off Docker ──────────
# S3_BUCKET_NAME=
# KINESIS_STREAM_NAME=

# ── Phase 1 (needed now) ──────────────────────────────────────────
OPENAI_API_KEY=

# Qdrant runs locally via Docker — no key needed
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# ── Phase 2+ (fill in later) ──────────────────────────────────────
ANTHROPIC_API_KEY=
COHERE_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=enterprise-rag-agents

# ── Phase 4 (AWS deployment) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# API key for the FastAPI app
API_KEY=

# ── AWS Bedrock (all AI calls — data never leaves the VPC) ───────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model IDs — override if your account uses cross-region inference profiles
BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ── Embedder ──────────────────────────────────────────────────────────────────
# "haiku" = contextual enrichment via Claude Haiku before embedding (recommended)
# "skip"  = embed raw chunk text directly (no Haiku calls)
EMBEDDER_CONTEXT_MODE=haiku

# ── Vector Store (Docker locally, Qdrant Cloud on AWS) ────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# ── Task Queue (Redis Docker locally, SQS on AWS — only URL changes) ──────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Metadata + Hash Store (PostgreSQL Docker locally, RDS on AWS) ─────────────
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb

# ── Chunker ───────────────────────────────────────────────────────────────────
# "haiku" = Claude Haiku classifies chunk type (financial table, narrative, etc.)
# "keyword" = simple keyword classifier (no Bedrock call, faster, less accurate)
CHUNK_CLASSIFIER=haiku

# ── API ────────────────────────────────────────────────────────────────────────
API_KEY=

# ── AWS Phase B migration — only these change when moving off Docker ──────────
# S3_BUCKET_NAME=
# KINESIS_STREAM_NAME=

# ── Auth (JWT) — added Phase 3 ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=10
LOGIN_RATE_LIMIT_PER_MIN=5

# ── Optional: external Cohere reranking ───────────────────────────────────────
# Disabled by default so document data stays inside AWS/Bedrock.
# Only enable if your deployment explicitly permits sending candidate text to Cohere.
# ALLOW_EXTERNAL_RERANK=false
# COHERE_API_KEY=

# ── CORS (browser security) ───────────────────────────────────────────────────
# Set this before serving financial data from a browser client.
# Leave empty for local dev only (allows all origins — NOT safe for production).
# Example: ALLOWED_ORIGINS=https://app.yourbank.com,https://admin.yourbank.com
# ALLOWED_ORIGINS=
